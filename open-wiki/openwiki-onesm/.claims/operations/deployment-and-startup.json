    {
      "id": "claim_9852b21f5fc74b6eaeb19ca7a3931704",
      "statement": "Server startup is gated on SecureKS.load returning true: a wrong or missing master key leaves the process waiting on the ConsoleMXBean (or logs SEVERE and returns false) without starting the HTTP port, and after either startup branch Main starts a MainThread that blocks in wait() for the lifetime of the JVM so shutdown is externally terminated.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/Main.java#L36-L45",
          "version": "repo-lines-v1:sha256:6d448b0d32e7c59a88ff48bc38baa41346e69afe4008e95d9f0201e37d6c9d57:"
