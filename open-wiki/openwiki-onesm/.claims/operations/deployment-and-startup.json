    {
      "id": "claim_fcfd6164e5014f6c8ffb24e6eb19bd46",
      "statement": "Main.main chooses between immediate startup (when app.master_key is set: SecureKS.load then startServers) and deferred startup (when absent: register ConsoleMXBean com.onepay.onesm:type=Console; a later JMX setMasterKey call triggers SecureKS.load, and on success startServers plus unregisterMBean).",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/Main.java#L20-L34",
          "version": "repo-lines-v1:sha256:e0a2e09f43c52f2dd75ce21eea8dcb09a6b9f7b791af92044cbf1546714f6adc:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/jmx/ConsoleMXBeanImpl.java#L12-L20",
          "version": "repo-lines-v1:sha256:ddf77daafebf8f2dee7e4fc9c3a8a746f8f63cfaa73b7708bbd40abfc4ea2de5:"
        }
      ]
    },
    {
      "id": "claim_7f513a6874754643b7d03bb7fec2b8ff",
      "statement": "startServers reads app.port (default \"0\") and only starts a Netty HttpServer thread when the value is greater than zero, so port 0 or absent skips HTTP; the HTTP server binds the configured port on a dedicated thread.",
