    {
      "id": "claim_a9d65bdb5581457d9b3ee332e2b1d6ab",
      "statement": "SecureKS loads a JCEKS KeyStore from the classpath resource /keystore.jceks (src/main/resources/keystore.jceks) using the supplied master key, holding the unlocked store in a static field for the process lifetime.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/SecureKS.java#L27-L30",
          "version": "repo-lines-v1:sha256:852697edb9b65ea340d74a22117de64bc4bf05e88d2dcfc4da8c70c1a9c596c0:"
        },
        {
