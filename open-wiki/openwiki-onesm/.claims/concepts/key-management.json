    {
      "id": "claim_a53f7a15aba6461bbe659a388acdaa00",
      "statement": "When no master key is supplied at launch, Main registers a com.onepay.onesm:type=Console MBean and waits; ConsoleMXBeanImpl.setMasterKey later calls SecureKS.load and, on success, starts the HTTP servers and unregisters the console bean.",
