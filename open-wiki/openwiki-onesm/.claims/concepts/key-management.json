          "resource": "repo://src/main/java/com/onepay/onesm/SecureKS.java#L25-L69",
          "version": "repo-lines-v1:sha256:51c0fb567f59fd2b7f330730fcbc02438b489beb9729e24ffef7d033828bda0b:"
