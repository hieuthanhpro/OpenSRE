    {
      "id": "claim_874fd48dd1ba4b859bfd88be561290f4",
      "statement": "getHttpClientKey(clientId) reads the alias http_client.<clientId> directly from the keystore (un-cached) with an empty password and returns the raw encoded key bytes; it is the per-client HMAC request-signing key used by HttpServerHandler.checkSignature.",
