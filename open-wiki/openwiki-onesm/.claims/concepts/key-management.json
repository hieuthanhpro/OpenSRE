          "version": "repo-file-v1:sha256:7fdf740866cb4b190b288ba2a046a182e330c097441bbd9ab1282d42ed4bfae4"
        }
      ]
    },
    {
      "id": "claim_6825914c2f584e3791eb81e5f86727de",
      "statement": "SecureKS.load builds two Guava LoadingCaches (keys and certificates) each bounded to maximumSize(1000) with expireAfterAccess(5, TimeUnit.MINUTES), loading entries lazily from the keystore with an empty password.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/SecureKS.java#L31-L61",
          "version": "repo-lines-v1:sha256:294cd9dc2f7d924d9bf0a6b5bc68c6c81969f2674c2bbcf33475e9d8665757b0:"
        }
      ]
    },
    {
      "id": "claim_270c95490d06458c8eef6c4be1146149",
      "statement": "SecureKS.load registers the key cache as a JMX MBean com.onepay.onesm:type=Cache,name=KeyStore on the platform MBean server; registration is skipped if the name is already registered.",
      "evidence": [
        {
