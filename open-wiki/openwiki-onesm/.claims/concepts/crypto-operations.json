        }
      ]
    },
    {
      "id": "claim_b3ba905f3d0a4737be26a1dac68b7d51",
      "statement": "encryptAES(byte[], SecretKey) uses AES/CBC/PKCS5Padding with a JCE-generated random IV and prepends that IV to the ciphertext so the output is self-describing; decryptAES(byte[], SecretKey) reads the first cipher.getBlockSize() bytes back as the IV.",
      "evidence": [
