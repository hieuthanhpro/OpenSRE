  "claims": [
    {
      "id": "claim_a97d2b0187784250bffe5fdf496dfc72",
      "statement": "HttpServerHandler.checkSignature is a mandatory authentication gate: processRequest calls it before any endpoint routing, and any failure — unparseable Authorization header, unknown clientId, null client key, or signature mismatch — short-circuits to 401 UNAUTHORIZED_ACCESS with error name UNAUTHORIZED_ACCESS.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L136-L214",
          "version": "repo-lines-v1:sha256:8b1c5f6ddfd32be5c32926a0db1324ecdc7ac258886952b10ba69464cad35a55:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L222-L254",
          "version": "repo-lines-v1:sha256:b731600282fcdd5a18a5c94d81924b5182d72577d9ef43eecb19527ec6cffdbf:"
        }
      ]
    },
    {
      "id": "claim_917ec42f66ab4aea8fb7244ab554ac85",
      "statement": "The Authorization (or X-Authorization fallback) header is parsed by the pattern '^[^ ]+ +([^:]+):(.+)$', where group 1 is the clientId and group 2 is the client-supplied signature; the leading scheme token is consumed by the regex but otherwise ignored.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L232-L239",
          "version": "repo-lines-v1:sha256:3458017b839e4b2fa79bdafd1a9f260f4e40eda14ce11e0ed7baa1cbe4aae463:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L45-L45",
          "version": "repo-lines-v1:sha256:bf172f7f447fd6a28b1a4da0b77cf1b12a2104733bf2fad84f3c6baebfb1d774:"
        }
      ]
    },
    {
      "id": "claim_153b3cc8ee974a18808c40637b3895f5",
      "statement": "Client signing keys are resolved by SecureKS.getHttpClientKey(clientId), which reads the http_client.<clientId> JCEKS keystore alias directly (not through the cache) with an empty password and returns the raw encoded bytes; a null result fails authentication.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/SecureKS.java#L84-L94",
          "version": "repo-lines-v1:sha256:1de004b4c34532c7d21380f13641889a8dbd3824b700d6d719667128aafd6d92:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L240-L248",
          "version": "repo-lines-v1:sha256:d0a5dceee2149e2894216facdac57850cac7e3e59a95da414ee19daac03aeb8d:"
        }
      ]
    },
    {
      "id": "claim_1c1f175ff438494fabcdb755065a34e0",
      "statement": "signRequest builds the request string-to-sign from five newline-separated fields — HTTP method, request path (raw URI including query string), date header, content type, and SHA-256 of the UTF-8 body encoded as url-safe base64 (empty string when the body is empty) — and HMAC-SHA256s it with the client key, returning an unpadded url-safe base64 signature.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/Crypto.java#L25-L37",
          "version": "repo-lines-v1:sha256:582378ae04e87ea8148bf6d6c9f47c19c29ea6fb09ade7527b347e8e33fc8dc5:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L303-L310",
          "version": "repo-lines-v1:sha256:0ac484076cb54989f0eb6940f36f27792b68a49cd92096a65e41af3d9bc82f0a:"
        }
      ]
    },
    {
      "id": "claim_5f869b8a6e7b47b59001aa3ea7f59c29",
      "statement": "Request authentication succeeds only on exact case-sensitive string equality between the recomputed signRequest output and the client-supplied signature (requestSignature.equals(clientSig)).",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L242-L247",
          "version": "repo-lines-v1:sha256:6e83ad17466b3e5d666ea0aa2dffe09b59cfcf6392c97a9952c4e7c5c98e0faf:"
        }
      ]
    },
    {
      "id": "claim_d0e2a124d75447e686ad9a313366b5f8",
      "statement": "Every response is emitted through writeResponse, which sets Content-Type application/json, X-Date in RFC-1123 GMT, and — only when a client key was resolved — an X-Secure-Hash header; signResponse builds its string-to-sign from the request signature, HTTP status code, response date, response content type, and response body SHA-256 and HMACs it with the same client key.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L256-L280",
          "version": "repo-lines-v1:sha256:2e5aa4310a452d688323bb08d08be3d881f8e32154e16d1f0b02b545a4bbbfdf:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L312-L319",
          "version": "repo-lines-v1:sha256:08c558761d22baf950b6fe388626713037466f9a9a9b2c0e4052d7a09560d16f:"
        }
      ]
    },
    {
      "id": "claim_b22d35bb68064f948db498b9adc535e0",
      "statement": "The response signature is cryptographically bound to the originating request: line one of the response string-to-sign is the recomputed request signature produced by checkSignature, so a response can only be verified with knowledge of both the shared client secret and that request's signature.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L312-L319",
          "version": "repo-lines-v1:sha256:08c558761d22baf950b6fe388626713037466f9a9a9b2c0e4052d7a09560d16f:"
        }
      ]
    },
    {
      "id": "claim_eab3c66b331f44038399151547ec8bc8",
      "statement": "The request date header (X-Date or Date fallback) is included in the request string-to-sign but is not parsed or checked for freshness — the implementation treats it as an opaque value and provides no replay-window protection; parseRFC1123Date exists but is unused in the auth path.",
      "evidence": [
