    {
      "id": "claim_770ce0d357a44db484887ed458d77149",
      "statement": "Every error is serialized by writeErrorResponse as a four-field JSON body with name, message, information_link, and details; recognized failures are 401 UNAUTHORIZED_ACCESS, 404 RESOURCE_NOT_FOUND, 405 METHOD_NOT_ALLOWED, 415 UNSUPPORTED_MEDIA_TYPE (non-application/json), 400 INVALID_KEY, 400 ALGORITHM_NOT_SUPPORTED, 400 UNSUPPORTED_ALGORITHM, 400 INVALID_CONTENT_FORMAT for JsonSyntaxException, and 500 INTERNAL_SERVER_ERROR for any other exception.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L176-L219",
          "version": "repo-lines-v1:sha256:07c513bd1da536fbfeff0cdbf171b156bf1770e71de5ea7d99b569954268ce36:"
        },
