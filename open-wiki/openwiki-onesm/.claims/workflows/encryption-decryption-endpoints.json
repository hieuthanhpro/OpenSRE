          "version": "repo-lines-v1:sha256:be0d2678c04dd091f396c625292ec1cc8a13a9c7ea604712619f5d7c0ec881cf:"
        }
      ]
    },
    {
      "id": "claim_ee9d2a3fc15640ec96b423b264366fd9",
      "statement": "All responses, success or error, route through writeResponse which sets Content-Type application/json, X-Date in RFC-1123 GMT, an X-Secure-Hash header signed via signResponse over request signature, status, date, content type, and body SHA-256 when a client key was resolved, plus Content-Length and Connection keep-alive for persistent connections.",
      "evidence": [
