    },
    {
      "id": "claim_28a0c5f377d74fbbbc0b68ab48562473",
      "statement": "The handler performs no crypto itself: it decodes base64 data with Base64.decodeBase64, resolves key material through SecureKS getKey/getPublicKey/getHttpClientKey, delegates each algorithm to the corresponding Crypto primitive, and re-encodes results with Base64.encodeBase64URLSafeString.",
      "evidence": [
        {
