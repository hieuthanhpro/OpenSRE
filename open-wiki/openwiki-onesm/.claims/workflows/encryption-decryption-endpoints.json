  "claims": [
    {
      "id": "claim_7b06e4f3e39240ecaeda821733b67d6d",
      "statement": "HttpServerHandler gates both crypto endpoints behind checkSignature; a request whose Authorization signature does not match is short-circuited to 401 UNAUTHORIZED_ACCESS before any routing or crypto dispatch.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L136-L214",
          "version": "repo-lines-v1:sha256:8b1c5f6ddfd32be5c32926a0db1324ecdc7ac258886952b10ba69464cad35a55:"
        }
      ]
    },
    {
      "id": "claim_351d6eaa3d264fabb001a644f2351fe8",
      "statement": "POST /encryptions with Content-Type application/json decodes data from base64 and resolves the signing/wrapping key by alias: the key field drives SecureKS.getKey, while the public_key field drives SecureKS.getPublicKey; a null key yields 400 INVALID_KEY with details naming the alias.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L140-L174",
          "version": "repo-lines-v1:sha256:ee411fce17f11e4d128a498a9b0a39a8b165fc266c53831b937483b11ac90694:"
        }
      ]
    },
    {
      "id": "claim_c3c60c205cc841c6a1d434eb40039112",
      "statement": "The /encryptions endpoint dispatches on key.getAlgorithm: HMACSHA256 routes to Crypto.hmacSha256 with the raw key bytes, AES routes to Crypto.encryptAES with a SecretKey, any algorithm containing RSA routes to Crypto.encryptRSA with a PublicKey, and anything else returns 400 ALGORITHM_NOT_SUPPORTED.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/Crypto.java#L31-L37",
          "version": "repo-lines-v1:sha256:ef31458cc5568ea6e456eb0d7c6498c738e79ab7bd811edb80550da6d35a79fd:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/Crypto.java#L88-L101",
          "version": "repo-lines-v1:sha256:9801009b15a682f32ed5fed1a3d1d5897ade048457437b9b3f843b043f8bc8ad:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L155-L171",
          "version": "repo-lines-v1:sha256:cdb9c1e2474208666fcaf4d0c531160f6a3a0313a0a866901f14b6803054442d:"
        }
      ]
    },
    {
      "id": "claim_58fed9a925314928826997aac816c958",
      "statement": "POST /decryptions supports only AES: the key field resolves via SecureKS.getKey, a null key returns 400 INVALID_KEY, a non-AES key returns 400 UNSUPPORTED_ALGORITHM, and an AES key drives Crypto.decryptAES to produce the decryption_data field.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L182-L202",
          "version": "repo-lines-v1:sha256:5381f61922f3d6f72a2dd572a2db2a5783ef047785f25306c5539eb70c0ffa73:"
        }
      ]
    },
    {
      "id": "claim_4d81b57c847e4a9885bf6d6431bfdfcb",
      "statement": "A successful /encryptions response returns 200 OK with JSON fields response_code 0 and encryption_data as url-safe unpadded base64 of the crypto output; /decryptions returns response_code 0 and decryption_data; AES output carries the random IV prepended to the ciphertext.",
