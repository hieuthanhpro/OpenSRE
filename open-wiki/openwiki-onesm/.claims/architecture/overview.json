  "claims": [
    {
      "id": "claim_ddfe909833a944ef8354c2c32734be54",
      "statement": "onesm is a Java 11 Netty HTTP crypto service packaged as the Maven artifact com.onepay:onesm:1.20230312; the build compiles for Java 11 and copies runtime dependencies into target/lib via maven-dependency-plugin copy-dependencies so the service runs from classes plus a flat lib of jars.",
      "evidence": [
        {
          "resource": "repo://pom.xml",
          "version": "repo-file-v1:sha256:9cc089a579c254f0890a35df67abbdc36cd45ed7d9f7aa7aec6dc1c6de92c5bd"
        },
        {
          "resource": "repo://pom.xml#L7-L44",
          "version": "repo-lines-v1:sha256:4bb24b28ccb94afe4cd0b3d134942084bc0dde6636347ecc94fc8eb9e7edcfdf:"
        }
      ]
    },
    {
      "id": "claim_67ccc8e1be5f4b70834ce5ef0bac771a",
      "statement": "Main.main() selects startup mode from the app.master_key system property: with a master key it calls SecureKS.load then startServers, otherwise it registers the ConsoleMXBean (com.onepay.onesm:type=Console) on the platform MBean server and blocks; ConsoleMXBeanImpl.setMasterKey later triggers the same SecureKS.load plus startServers sequence and unregisters the bean.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/Main.java#L20-L34",
          "version": "repo-lines-v1:sha256:e0a2e09f43c52f2dd75ce21eea8dcb09a6b9f7b791af92044cbf1546714f6adc:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/jmx/ConsoleMXBeanImpl.java#L13-L21",
          "version": "repo-lines-v1:sha256:b033ebd309a795cbb864149ebd69600a1fc2d77390ced6b82473d10e06c5802e:"
        }
      ]
    },
    {
      "id": "claim_583e73b89aa34103ace9b83b63e1e5f9",
      "statement": "startServers() reads the app.port system property and, when greater than zero, starts an HttpServer on a dedicated thread; port 0 or absent disables the HTTP listener, and the main thread then blocks in a wait() loop for the process lifetime.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/Main.java#L36-L45",
          "version": "repo-lines-v1:sha256:6d448b0d32e7c59a88ff48bc38baa41346e69afe4008e95d9f0201e37d6c9d57:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/Main.java#L47-L61",
          "version": "repo-lines-v1:sha256:73d4dd479896c3f80941b19e84a0d8d5496dfa46770c901fe571595faad9bd2e:"
        }
      ]
    },
    {
      "id": "claim_1560ad73bf6a47e48a94f4aa4ca3edd6",
      "statement": "HttpServer builds a Netty ServerBootstrap with a single-thread boss NioEventLoopGroup, a default worker group, NioServerSocketChannel, an INFO LoggingHandler on the server channel, and an HttpServerInitializer child handler, then binds the configured port and blocks on the channel close future, shutting both groups down gracefully afterward.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServer.java#L24-L49",
          "version": "repo-lines-v1:sha256:4b7fa786a3147d6c87651f7de2d52e9b230910d3cc1a1770358e04e256d3e4dd:"
        }
      ]
    },
    {
      "id": "claim_a05878cab68c4df4bd9bde990829a20b",
      "statement": "HttpServerInitializer assembles the per-connection Netty pipeline as HttpRequestDecoder, HttpResponseEncoder, then a single HttpServerHandler; HTTP content is not aggregated with HttpObjectAggregator, so the handler must buffer HttpContent chunks itself.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L121-L133",
          "version": "repo-lines-v1:sha256:ce8eb4cdc2293ae16a7303013e5b86be3a415de5a0d196ab54e5da9bd236718a:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerInitializer.java#L23-L37",
          "version": "repo-lines-v1:sha256:adb7928715187de1ef459d36df98a47e60e6a62d4895b212f6a0f4bec7abd38d:"
        }
      ]
    },
    {
      "id": "claim_e899d32e27f54519b31bb72791531f2c",
      "statement": "HttpServerHandler buffers the HttpRequest headers and streams HttpContent chunks into a StringBuilder until LastHttpContent, then invokes processRequest with the complete body; processRequest authenticates via checkSignature, dispatches to the /encryptions or /decryptions handlers, and writes a signed JSON response.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L136-L220",
          "version": "repo-lines-v1:sha256:c53f91fd906a8add8ddc691d836166e125ba1d46c616449c15f41dc685bc4f68:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L97-L133",
          "version": "repo-lines-v1:sha256:dd31c8b360ee7c0072fa53f0dcc22a1bf2c81d75a12bcb202d80d4d963f4b26c:"
        }
      ]
    },
    {
      "id": "claim_68f3d1ac29394167a574d7f679eb44dc",
      "statement": "Request authentication requires a matching clientId and signature parsed from the Authorization (or X-Authorization) header; checkSignature resolves http_client.<clientId> via SecureKS.getHttpClientKey, recomputes the request signature, and rejects with 401 UNAUTHORIZED_ACCESS on any parsing failure, unknown client ID, missing key, or signature mismatch.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/SecureKS.java#L84-L94",
          "version": "repo-lines-v1:sha256:1de004b4c34532c7d21380f13641889a8dbd3824b700d6d719667128aafd6d92:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L222-L254",
          "version": "repo-lines-v1:sha256:b731600282fcdd5a18a5c94d81924b5182d72577d9ef43eecb19527ec6cffdbf:"
        }
      ]
    },
    {
      "id": "claim_2ff266c6c80a41528c6ce59e760bd97d",
      "statement": "The endpoint algorithm is selected by the resolved key: an HMACSHA256 key yields HMAC output, an AES key yields AES output, an RSA key yields RSA output, an unsupported algorithm yields 400 ALGORITHM_NOT_SUPPORTED, and a missing key yields 400 INVALID_KEY; /decryptions only accepts an AES secret key and returns 400 UNSUPPORTED_ALGORITHM otherwise.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L140-L208",
          "version": "repo-lines-v1:sha256:378fddbc24a6280ad4e7bf0ca84bd31d33a2716e7d3a434131238d07ee0a7e32:"
        }
      ]
    },
    {
      "id": "claim_c12d13081a0a444cbfc6a76e3e3b2bf0",
      "statement": "Both crypto endpoints require POST with Content-Type application/json; other methods and media types yield 405 METHOD_NOT_ALLOWED and 415 UNSUPPORTED_MEDIA_TYPE respectively, unknown URIs yield 404 RESOURCE_NOT_FOUND, malformed JSON yields 400 INVALID_CONTENT_FORMAT, and unchecked exceptions map to 500 INTERNAL_SERVER_ERROR.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L176-L181",
          "version": "repo-lines-v1:sha256:c3bae1b95389c0876d0ab0ea5c4afc27b4c3821cb064dbd3357536219c98a89e:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/http/HttpServerHandler.java#L209-L219",
          "version": "repo-lines-v1:sha256:21d30acabe28b6daac3eb663e77b2fa8feba022d66aa523d4364504c979a13b3:"
        }
      ]
    },
    {
      "id": "claim_e8ad8ee8a8cb47c596e02f32c2053e0b",
      "statement": "SecureKS loads a JCEKS KeyStore from the classpath resource /keystore.jceks using the supplied master key and maintains two Guava LoadingCaches (keys and certificates) bounded at 1000 entries with a 5-minute expireAfterAccess that load entries lazily from the keystore; client signing keys are read under the http_client.<clientId> alias with an empty password.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/onepay/onesm/SecureKS.java#L25-L70",
          "version": "repo-lines-v1:sha256:93288acdd42711c75fa577e38b853f11cb540c8ed27b53b19f2cd0b1047c57eb:"
        },
        {
          "resource": "repo://src/main/java/com/onepay/onesm/SecureKS.java#L84-L94",
          "version": "repo-lines-v1:sha256:1de004b4c34532c7d21380f13641889a8dbd3824b700d6d719667128aafd6d92:"
        }
      ]
    },
    {
      "id": "claim_2bac3c1e8eb34a2bb15e88450df8e4d3",
      "statement": "The keys Guava cache is exposed to JMX as com.onepay.onesm:type=Cache,name=KeyStore via GuavaCacheMXBeanImpl, which surfaces hit/miss rates, load counts, eviction counts, size, and cleanUp/invalidateAll/refreshAll operations.",
      "evidence": [
