    {
      "id": "claim_b800e6ccd64640b787cbebdfb95a24fc",
      "statement": "The response is signed with an X-Secure-Hash header when the client key was resolved; signResponse binds the request signature, status code, response date, content type, and body SHA-256 hash into an HMAC-SHA256 signature so the client can verify the response corresponds to the request.",
