    {
      "id": "claim_7a12379fef76406b86c269e52cbe261a",
      "statement": "Crypto provides SHA-256 url-safe base64 hashing, HMAC-SHA256, AES/CBC/PKCS5Padding encryption and decryption (with the no-IV variant prepending a generated IV to the ciphertext), RSA/ECB/PKCS1Padding, and hex encode/decode helpers.",
