      "id": "claim_aeabb5b170474dd5809091f1781bf72a",
      "statement": "onesm (com.onepay:onesm:1.20230312) is a Java 11 HTTP cryptographic service built on Netty that exposes HMAC-authenticated HTTP endpoints to encrypt and decrypt payloads using keys held in an encrypted JCEKS keystore.",
      "evidence": [
        {
          "resource": "repo://pom.xml#L7-L14",
          "version": "repo-lines-v1:sha256:11ac1d4fe6d885543771598e298cc7467f89515e9964239857ca37728fec6c38:"
