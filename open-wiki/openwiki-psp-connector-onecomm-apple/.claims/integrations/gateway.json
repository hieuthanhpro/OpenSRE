          "version": "repo-lines-v1:sha256:258f97a9b9108068bb4e145fc57d02e4e78100b456ad23cbf62f26a8ac67a7dd:"
        }
      ]
    },
    {
      "id": "claim_98c538fe136d4227978b4339279f94c0",
      "statement": "The cardSite for a resolved bank determines the flow: banks TECHCOMBANK, DONGABANK, CUP, VIETBANK, and VIETTELPAY use direct bank redirect (selectBank), while all other banks perform card detail verification through OnePAY (verifyCard).",
