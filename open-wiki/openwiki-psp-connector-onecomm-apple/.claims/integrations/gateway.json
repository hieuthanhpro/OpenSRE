    {
      "id": "claim_18bf5a0e02944f88b99bb3d0531de1c5",
      "statement": "The Onecomm Gateway communicates with the external Onecomm service using the Hessian binary serialization protocol over HTTP/HTTPS. Requests are wrapped with a custom Hessian header containing the 'execute' method name, and Java objects are serialized via ObjectOutputStream.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/provider/onecomm/OnecommGateway.java#L678-L720",
          "version": "repo-lines-v1:sha256:f4945bf45f81d02043287d7cc35049266416c233e5d490848e96664995325d3d:"
        },
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/provider/onecomm/OnecommGateway.java#L973-L1006",
          "version": "repo-lines-v1:sha256:ee06c4bed66be11eb48437ff0389b8f43fa965e9f596f61c4ee7a569b74be8b7:"
        }
      ]
    },
    {
      "id": "claim_037a8888794148adaa9e471f5d176df7",
      "statement": "The gateway service endpoint and timeout are configurable via system properties: onecomm_service_url (default http://localhost/onecomm-payservice-apple/execute) and onecomm_service_timeout (default 60000 ms). Requests are sent with content type x-application/hessian and a per-request timeout.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/provider/onecomm/Config.java#L11-L17",
          "version": "repo-lines-v1:sha256:9b0aefd42c48a24f34227782c900418e79df5730789f5befe11b1c535995c38c:"
        },
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/provider/onecomm/OnecommGateway.java#L709-L709",
