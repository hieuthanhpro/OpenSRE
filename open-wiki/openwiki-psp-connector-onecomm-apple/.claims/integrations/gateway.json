        }
      ]
    },
    {
      "id": "claim_6b78262a65cc469bb75f02fb1568e23b",
      "statement": "Refund operations build RefundReq or RefundConfirmReq objects and route them to the Onecomm service. Refund2 additionally supports dispute (vpc_Dispute), direct (vpc_Direct), and manual command code (MANNUAL) scenarios, and maps the original merchant transaction reference onto the refund result id when both dispute and direct flags are 'y'.",
      "evidence": [
        {
