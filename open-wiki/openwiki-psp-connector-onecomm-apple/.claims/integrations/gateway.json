        }
      ]
    },
    {
      "id": "claim_1fb6ac9c70454ca9a23e5363ebf8370f",
      "statement": "The updateAuth method handles OTP submission (via authorization_input), bank redirect callbacks (via authorization_result with vpc_TxnResponseCode), and transaction confirmation. Confirmed transactions validate a 64-char hex ID (MD5 hash of local id) or call confirm() with a ConfirmAuthenticationReq, matching vpc_Merchant and vpc_MerchTxnRef before setting approved/failed state.",
      "evidence": [
        {
