          "version": "repo-lines-v1:sha256:8e8519e914dd78a1f05f0538ca990dee19659a027ee76262e605246902263542:"
        }
      ]
    },
    {
      "id": "claim_c108fae0037949b9a948f52f53a5e4fa",
      "statement": "Bank identification from an instrument is derived by matching card/account numbers against per-bank regex patterns (e.g., VIETCOMBANK 970436, VPBANK 970432) to produce a numeric bankId; NAPAS cards (np_card type) resolve to NAPAS-specific bank ids in the 33-73 range, and non-card account types map to fixed bank ids.",
      "evidence": [
