    },
    {
      "id": "claim_889ce411275c45f190d2dcd2fe808cfd",
      "statement": "Instrument card verification sends a fixed 5000 VND token request (verify_card merchant credentials, 'mPAY Verify Card' order info) to OnecommGateway.verifyCard; the resulting state is APPROVED when the gateway replies AUTHORIZATION_REQUIRED and FAILED with the reason otherwise, and the response is returned with HTTP 201.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/provider/onecomm/OnecommPaymentServiceProvider.java#L149-L183",
          "version": "repo-lines-v1:sha256:32a9321b41e34232257161818547d685c9129722bd7821fcd6a564c463433cf4:"
        }
      ]
    },
    {
      "id": "claim_4ab759e46def41ed9a18c9d07e69836e",
      "statement": "instrumentRegistrationByTxn looks up a previously approved payment from 'transaction' context, normalizes a 2- or 3-digit instrument year to 4 digits, reuses the approved payment's instrument plus its state, and returns it with HTTP 201; a missing payment list or a non-approved state is rejected with INVALID_PAYMENT.",
      "evidence": [
