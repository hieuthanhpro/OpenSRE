    {
      "id": "claim_1ba5b78f86e2444abf447ebdea862404",
      "statement": "instrumentRegistrationByCard builds a verification instrument and applies bank-specific fixes: for 'oceanbank_card' it forces card_type=ATM and auth_method=SMS; for 'vpb_card' it derives mobile_number from channel_user_id by replacing a leading '84' with '0'.",
      "evidence": [
