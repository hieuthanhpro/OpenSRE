          "resource": "repo://src/main/java/vn/onepay/pspconnector/provider/onecomm/OnecommPaymentServiceProvider.java#L77-L122",
          "version": "repo-lines-v1:sha256:3b9d65c852391826b551df1bb59dcf1676db9a764940655f673e7872a5a31caf:"
        }
