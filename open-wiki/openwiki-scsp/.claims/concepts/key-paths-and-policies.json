  "claims": [
    {
      "id": "claim_bbc70a6e96e84014bc0577e055efc450",
      "statement": "HTTP key addressing is a two-level (key path, optional subkey) grammar enforced in parseKeyPathSubkey: a value ending in `/` is a pure key path validated by `^/[-0-9a-zA-Z_/]+/$`, while a value without a trailing `/` is split on `/`, with the last segment becoming the subkey (`^[-0-9a-zA-Z_]+$`) and the remainder re-wrapped as `/` + join + `/`; violations return 400 naming the failed regex.",
      "evidence": [
        {
          "resource": "repo://internal/adapters/driving/rest/handler.go#L29-L94",
          "version": "repo-lines-v1:sha256:0251ac87794d32c8ddc4453d142ffaa96c83e8239f5139007fb98f3097c75f76:"
        },
        {
          "resource": "repo://internal/adapters/driving/rest/handler.go#L332-L343",
          "version": "repo-lines-v1:sha256:9ef0563a0c60010e5ebc0a00fa216aca312a92890e8c668f3cc2554f810ab3d0:"
        }
      ]
    },
    {
      "id": "claim_f328904e5c2f4386a95b7bce18f7a920",
      "statement": "Key paths always begin and end with `/` and subkeys never contain `/`, and neither may contain dots, spaces, or punctuation, which keeps the `path + \"::\" + key` cache keys and URL parsing unambiguous.",
      "evidence": [
        {
          "resource": "repo://internal/adapters/driving/rest/handler.go#L159-L177",
          "version": "repo-lines-v1:sha256:a23647a3be343678baf377cfd4037fa81d322cd8b26176cbd280bbad3603ccff:"
        },
        {
