    {
      "id": "claim_32c80878c0f74cfcb418b82047d5c5a9",
      "statement": "Versions start at 1 on create and update is optimistic-concurrency controlled: the UPDATE sets n_version = n_version + 1 only when n_version equals the caller-supplied version, and on no-match the adapter runs a follow-up query to distinguish ErrKeyNotFound (no live row) from ErrVersionConflict (row exists with a different version), which the handler maps to 404 and 409 respectively.",
      "evidence": [
        {
          "resource": "repo://internal/adapters/driven/postgres/storage.go#L122-L182",
          "version": "repo-lines-v1:sha256:cbbfc29354089b2401ca36368b38adc0629c88e4f5c503d327a07b8eaaf91cd1:"
