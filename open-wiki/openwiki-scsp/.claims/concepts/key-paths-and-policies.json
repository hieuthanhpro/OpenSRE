    {
      "id": "claim_5d37adc7a386444fb44d41c03f2457bd",
      "statement": "custom_metadata is a free-form JSON object from the client that the usecase marshals into the s_custom_metadata column, aborting the operation on marshal failure; on read the handler unmarshals it back, treating an empty stored string as an empty object and returning 500 \"Failed to parse metadata\" if stored metadata no longer parses. No semantic validation is applied, so callers own the meaning of their metadata keys.",
      "evidence": [
        {
          "resource": "repo://internal/adapters/driving/rest/handler.go#L303-L313",
