          "version": "repo-lines-v1:sha256:a972b7e5e422b5692f3be8aa1cf1d8dadcfa559a915febc92325cbf900556533:"
        }
      ]
    },
    {
      "id": "claim_5d15033dd1fb4e34b75e361bea252e82",
      "statement": "port.KeyData is the metadata record returned by storage operations, carrying Key (subkey), Value (ciphertext as persisted or plaintext after a usecase read), Version, Metadata (JSON string), CreatedAt, and UpdatedAt.",
