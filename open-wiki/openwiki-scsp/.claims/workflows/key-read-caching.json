        }
      ]
    },
    {
      "id": "claim_6a52d84bbaf749cbaa1e445247d4eab7",
      "statement": "Within the singleflight callback, sql.ErrNoRows maps to port.ErrKeyNotFound while other storage errors and decrypt errors are returned verbatim, and the cache is written only after both the storage read and the Vault transit decrypt succeed.",
      "evidence": [
        {
          "resource": "repo://internal/adapters/driven/postgres/storage.go#L185-L210",
