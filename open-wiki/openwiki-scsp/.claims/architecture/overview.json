    {
      "id": "claim_fe9a722c19354a5c9d55d664939155ff",
      "statement": "cmd/server/main.go is the composition root: it constructs the logger, config, tracer, Vault, Postgres, and Ristretto adapters, then injects them into the usecases and the REST handler, which is the only place concrete adapter implementations are chosen.",
      "evidence": [
        {
          "resource": "repo://cmd/server/main.go#L22-L80",
          "version": "repo-lines-v1:sha256:51d4947bb303252f4fd7c7e67381d3ac75437d15c8c8d49383f38dcfe1a18b91:"
