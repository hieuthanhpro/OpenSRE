    {
      "id": "claim_913431f6d45b48b5821c722f7704cc02",
      "statement": "The SCSP service follows a hexagonal layout: the driving REST adapter in internal/adapters/driving/rest calls domain usecases in internal/domain/usecase, which depend only on abstract ports in internal/domain/port, and the driven adapters in internal/adapters/driven (postgres, vault, cache) implement those ports.",
      "evidence": [
        {
          "resource": "repo://cmd/server/main.go#L12-L20",
          "version": "repo-lines-v1:sha256:303c10bef04038c40e60bf634976faa38f724d1c2e3352cd0c07f787cb4fc5af:"
        },
        {
