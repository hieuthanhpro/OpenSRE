    {
      "id": "claim_80642553be984595b6cbecf2e0f11555",
      "statement": "Read is cache-first: on a cache miss, error, or failed type assertion the usecase enters a singleflight group keyed by path+\"::\"+key, fetches via StoragePort, decrypts via EncryptionPort, and stores the plaintext plus KeyData in the cache; only successful fetches and decrypts are cached, and storage sql.ErrNoRows is mapped to port.ErrKeyNotFound.",
      "evidence": [
        {
          "resource": "repo://internal/adapters/driven/cache/ristretto.go#L54-L82",
          "version": "repo-lines-v1:sha256:564ca9a8fec74746c59e59ed572eee89340b1f06558b29d302c8e624df80465f:"
