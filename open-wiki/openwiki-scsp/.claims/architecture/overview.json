        }
      ]
    },
    {
      "id": "claim_42e6a35d4887430dbca161db036684fa",
      "statement": "Startup order in main.go is fixed and fail-fast: logger, config load, tracer init, Vault adapter, Postgres adapter, cache adapter, usecases, handler/router; any failure in config, tracer, Vault, Postgres, or cache initialization calls Fatalf and terminates the process.",
      "evidence": [
        {
