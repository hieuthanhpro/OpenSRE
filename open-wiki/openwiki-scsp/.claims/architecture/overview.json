    {
      "id": "claim_48f081c93cd64cd8aa9bf0f6db4e8135",
      "statement": "The Postgres adapter implements StoragePort over table scsp.tb_kv_store with soft deletes: reads filter on s_state != 'DELETED', deletes set s_state to 'DELETED' and d_delete, Save and Update run in a transaction, Save rejects existing live keys with port.ErrKeyAlreadyExists, and Update uses an optimistic version predicate that distinguishes ErrKeyNotFound from ErrVersionConflict.",
      "evidence": [
        {
          "resource": "repo://internal/adapters/driven/postgres/storage.go#L122-L182",
          "version": "repo-lines-v1:sha256:cbbfc29354089b2401ca36368b38adc0629c88e4f5c503d327a07b8eaaf91cd1:"
