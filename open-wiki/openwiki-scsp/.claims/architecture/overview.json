          "version": "repo-lines-v1:sha256:29ac5fea3883123aa00fbe7d1267751b4fa5ce54a85a1e1d2089f9f27659ecf6:"
        }
      ]
    },
    {
      "id": "claim_786f4a24525043469225e0a36638a8d1",
      "statement": "Domain usecases depend only on domain port interfaces (EncryptionPort, StoragePort, CachePort, AuthStoragePort, LoggerPort) and hold no concrete adapter types, so infrastructure selection is fully deferred to startup wiring.",
      "evidence": [
        {
          "resource": "repo://internal/domain/usecase/auth_usecase.go#L28-L34",
          "version": "repo-lines-v1:sha256:e35ce4c9bcdfaaad06de1621a50bfa3337e9231fb4fa746a37ae7517602d22db:"
