    {
      "id": "claim_746da06d8e0744b7b0be0411513b80b5",
      "statement": "Before any business route runs, the shared pipeline requires JSON Accept and Content-Type headers plus X-OP-Date, positive X-OP-Expires, and X-OP-Authorization; it extracts the client id into the routing context and verifies expiry and an HMAC signature reconstructed from method, path, query parameters, signed headers, and body bytes, rejecting failures with typed authorization or bad-request exceptions.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/psp/server/handler/common/ClientAuthorizationHandler.java#L35-L147",
          "version": "repo-lines-v1:sha256:45f20901abdbf8d4f4e3fcd0b739161f7b815158b9f89b15dce05739bd7c3eff:"
