    {
      "id": "claim_bb136b56a53f4ab480babe429c16bd63",
      "statement": "Failures anywhere in the router are normalized by ExceptionHandler into typed HTTP status mappings and a JSON error envelope, while successful work must stage response_code, response_desc, and response_data on the RoutingContext for ResponseHandler, which defaults missing staging values to HTTP 404 before emitting JSON.",
      "evidence": [
