        {
          "resource": "repo://src/main/java/vn/onepay/psp/server/handler/common/ClientAuthorizationHandler.java#L35-L147",
          "version": "repo-lines-v1:sha256:45f20901abdbf8d4f4e3fcd0b739161f7b815158b9f89b15dce05739bd7c3eff:"
        },
