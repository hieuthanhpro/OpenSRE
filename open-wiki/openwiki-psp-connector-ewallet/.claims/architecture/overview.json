    {
      "id": "claim_0b2d0654dcdd4e41b68e51e05436afb7",
      "statement": "Every inbound request is validated by ClientAuthorizationHandler before business routing; it requires JSON Accept and Content-Type, X-OP-Date, positive X-OP-Expires, X-OP-Authorization, matching service region/name/authorization type/algorithm, and a matching OWS signature, and rejects failures with AuthorizationException mapped to HTTP 401.",
