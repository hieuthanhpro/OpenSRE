  "claims": [
    {
      "id": "claim_f78cc63bc0b34cd0b81d9c85455c21bc",
      "statement": "The `vn.onepay.psp` entrypoint package makes `Main` the process composition root: it loads `app.properties`, eagerly creates the Oracle Hikari pool `PSP_EWALLET_DB_POOL`, builds the downstream `HttpServiceConfig`, injects it into `InstrumentPostHandler`, and configures `PspServer` with `PspVertical` before starting Vert.x deployment.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/psp/Main.java#L16-L70",
          "version": "repo-lines-v1:sha256:9d786d85af97700bff494cec56e4fb4d86584d0d70c1df7df637c006d5aaff1a:"
        },
        {
