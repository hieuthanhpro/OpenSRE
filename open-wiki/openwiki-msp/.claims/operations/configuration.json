  "claims": [
    {
      "id": "claim_39328c0cf0e94425a3cbd8d7e9ffdd29",
      "statement": "The `Config` class loads the entire `config.json` from the classpath once via a `TemplateProcessor` (secure config library) and caches it in a public `JsonObject config`; there is no externalized config store or env-based override, so a config change requires a rebuild and restart.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/msp/Config.java#L41-L51",
          "version": "repo-lines-v1:sha256:b351570f90992da54c6086aaa3054ebdc645ac206b2f6744670f92d61e72084d:"
        }
      ]
    },
    {
      "id": "claim_63f7d3d858b746eea231558301379da1",
      "statement": "The `server` block of `config.json` controls HTTP listen port, URI prefix, OWS authorization region/service, Vert.x runtime tuning (worker/event-loop pool sizes, blocked-thread timeout, max execute times, invoice locking, TCP keepalive, merchant cache), read via `Config` accessors and applied in `Main` when building `VertxOptions`.",
      "evidence": [
