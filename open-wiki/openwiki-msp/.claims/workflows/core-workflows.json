    {
      "id": "claim_93ee92a5a12649038f1fdf2759e79b9d",
      "statement": "Promotion validation for WSP/VPC payments calls OnePAYPrsp.createPayment before the actual payment is created; only on a success or PAYMENT_WITHOUT_PROMOTION result does the flow proceed to createStep1, otherwise an INVALID_PROMOTION error is returned.",
