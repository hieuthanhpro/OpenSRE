        }
      ]
    },
    {
      "id": "claim_8794ae59fc8d48d8a9e8fc590869c707",
      "statement": "Payment creation applies three-step processing: createStep1 collects instrument/amount/currency/installment parameters (including installment fee validation and customer fees), createStep2 builds and persists the PaymentDTO via the matched MSPConnector, and createStep3 sends PAYMENT_CREATED and then PAYMENT_APPROVED/PAYMENT_FAILED notifications, closing the invoice on failure when maxPayment is reached or the instrument type is UPOS_CARD.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/msp/resources/Payments.java#L279-L330",
          "version": "repo-lines-v1:sha256:a20d394f45e739b4337b6a981f012d51a256dac6aa68962d77fbc5c85d926479:"
