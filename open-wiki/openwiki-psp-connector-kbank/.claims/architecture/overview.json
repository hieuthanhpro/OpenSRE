    {
      "id": "claim_34613a25711e4867ba9e367e6ac90c03",
      "statement": "PaymentServiceProvider is an abstract class that defines operation methods for purchase, refund, capture, void, OTP verification, authorization updates, instrument management, and user operations; default methods throw METHOD_NOT_SUPPORTED, making it the strategy boundary between handlers and PSP-specific logic.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/provider/PaymentServiceProvider.java#L10-L83",
          "version": "repo-lines-v1:sha256:d6f47db1e7266c6141ebd85dec90f4042d6bfcc2e2495958a43eb87108331be4:"
        }
      ]
    },
    {
      "id": "claim_be4b80f483df408e96ca019156218c0a",
      "statement": "KBankPaymentServiceProvider implements the payment flows using Vert.x execBlocking chains: paymentPurchase creates a local payment, resolves merchant data via MSP, calls KBankGateway.addPaymentMethod, then updates payment state or inserts authorization; paymentRefund2 validates an approved payment, creates a refund record, calls KBankGateway.refund, verifies the response signature, and updates refund state; verifyOtp/verifyOtp2 fetch payment details, verify OTP with KBank, register and execute payment, and patch MSP settlement records.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/provider/kbank/KBankPaymentServiceProvider.java",
          "version": "repo-file-v1:sha256:a17cb5af0a81c3acbe66b94693a38bc1a010ffb2e5d0b4b79644854311462143"
        }
      ]
    },
    {
      "id": "claim_e6a15612143a4d90b4832e021950653e",
      "statement": "KBankGateway is the outbound HTTP client for the KBank external API; it builds encrypted payloads with KBankSecurity, signs requests, sends HTTP calls via WebClient, checks response signatures, and maps responses into provider-facing results.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/provider/kbank/KBankGateway.java",
          "version": "repo-file-v1:sha256:6420181eecaa50b245fdc20a6727467f865eb6edc1ef670c098859a35b7f44fd"
        }
      ]
    },
    {
      "id": "claim_0f69862b4e7841719e0cfe6dd10a81f9",
      "statement": "KBankMSPClient handles internal MSP API communication, enriching OTP requests with customer payment data, patching MSP authorization and settlement records, and generating standardized settlement responses.",
      "evidence": [
