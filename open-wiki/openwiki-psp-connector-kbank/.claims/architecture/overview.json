  "claims": [
    {
      "id": "claim_5d082798609a4db49e4a7f638aba17eb",
      "statement": "Main.java is the entrypoint: it loads app.properties, creates a HikariCP Oracle datasource, injects it into payment/authorization/refund/capture/void services and KBank.DB, assigns a KBankPaymentServiceProvider to handler statics, configures KBank gateway and security settings, and starts PSPConnectorServer.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/Main.java#L32-L106",
          "version": "repo-lines-v1:sha256:3541debfe51412dfcd41521067cf8de8a12c226fd5fec172e4923c70371dfb35:"
        }
      ]
    },
    {
      "id": "claim_1a29e2f716a445b4a54a03a07428abdb",
      "statement": "PSPConnectorServer starts a Vert.x instance with configured worker/event-loop pool sizes and blocked-thread settings, then deploys PSPConnectorVertical as the application verticle.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/PSPConnectorServer.java#L53-L71",
          "version": "repo-lines-v1:sha256:dccf12365184ce2013d8feb45f801358069632946fab7d2ece8e958f5237a34a:"
        }
      ]
    },
    {
      "id": "claim_cff12388098740c7911ce8b572eda01a",
      "statement": "PSPConnectorVertical creates a shared SSL WebClient with a 300-connection pool, mounts a Vert.x Router with BodyHandler, ResponseTimeHandler, TimeoutHandler, RequestLoggingHandler, and ClientAuthorizationHandler, registers business routes using RoutePool constants, and starts an HttpServer with keepalive and idle-timeout settings.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/vertical/PSPConnectorVertical.java#L73-L115",
          "version": "repo-lines-v1:sha256:189c4605fa23d5e12df04d2f22179302dcc221318fbc4fbf81d06ee10cf947fa:"
        }
      ]
    },
    {
      "id": "claim_9e37a382497946b1af75c8023a498984",
      "statement": "Every inbound request passes through the middleware pipeline in order: BodyHandler, ResponseTimeHandler, TimeoutHandler, RequestLoggingHandler, ClientAuthorizationHandler, then the matching route handler; failures go to ExceptionHandler and successful completions go to ResponseHandler.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/vertical/PSPConnectorVertical.java#L83-L99",
          "version": "repo-lines-v1:sha256:39892383b35e4f7ab4d5b691656762498cf453b70f75291e0322a8e16fa0640f:"
        }
      ]
    },
    {
      "id": "claim_421551846243439699e0e4a4f361eb0c",
      "statement": "ClientAuthorizationHandler enforces client identity by requiring Accept: application/json, X-Op-Date, X-Op-Expires, and X-Op-Authorization headers; it extracts the clientId from the authorization header, validates expiry, region, service name, terminator, and algorithm, recomputes the signature using the client access key from app.properties, and rejects mismatches with AuthorizationException or BadRequestException.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/handler/common/ClientAuthorizationHandler.java#L33-L146",
          "version": "repo-lines-v1:sha256:051aea64eaf5a87cfefffdd736c57fcf75ebc5e96b9840f299da8b36d3298445:"
        }
      ]
    },
    {
      "id": "claim_7b62d7c964a9424ab4786573af64708d",
      "statement": "PurchaseHandler, VerifyOTPHandler, and RefundPostHandler validate minimal request fields (body presence, merchantId, amount, currency for purchases; body presence for OTP; body and command field for refunds) and delegate to PaymentServiceProvider; they catch exceptions and pass them to rc.fail(e).",
