    },
    {
      "id": "claim_6b2e186bbdb148b99724b2ff8f3b2519",
      "statement": "Validation.validateRequest runs as a route handler on HTML GET endpoints: it derives the profile from vpc_Merchant, bypasses (rc.next()) merchants with no profile, checks required fields (a field is optional only if its regex matches the empty string), then validates every submitted field against its regex; any failure sets vpc_TxnResponseCode=7 and redirects to the error page via Config.getUserWebUrl plus theme or merchant URL.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/validation/Validation.java#L145-L172",
          "version": "repo-lines-v1:sha256:1c2ef5a63b223454c8bb1945415ae0aa44ff9907f6c4c5fad4cb2a226b4dde37:"
        },
