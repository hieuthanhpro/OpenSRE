          "version": "repo-lines-v1:sha256:82de2b8d88f971816667865e3d1e9fa527087836c2967fa3269794e94f5d9827:"
        }
      ]
    },
    {
      "id": "claim_de4c0dc036b64c439b797ae79715a5f2",
      "statement": "The get.invoices endpoint in validation.yaml defines exactly two merchant profiles: general (the default covering ONEPAY and TEST*/OP_* merchants with fields such as vpc_Amount, vpc_SecureHash, CardNum, CardMonth, CardYear, and FX fields) and shopify (used only by TESTSHOPIFY and TESTSHOPIFYTG, adding user_Branch, vpc_AuthIndicator, user_ShopifyAppID, user_ShopifyShopDomain, user_ShopifyGID, user_ShopifyTest, user_OrgAmount, user_ExchangeRate and pinning user_Client_Channel to SHOPIFY).",
      "evidence": [
        {
          "resource": "repo://src/main/resources/validation.yaml#L161-L254",
          "version": "repo-lines-v1:sha256:fc275691baa3c2cfbc11f76ed989b6a3db69a1a25c56ac8a8d2340709a7d17f1:"
        },
