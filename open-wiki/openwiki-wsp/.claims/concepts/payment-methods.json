    {
      "id": "claim_da7c935d8c9c4225b2918cca0a08376c",
      "statement": "Two families of per-bank card profiles coexist in config.properties: legacy domestic profiles (bank.1 through bank.30, e.g. VCB bank.1 card-format=^(6868[0-9]{12}|970436[0-9]{13})$ with auth-site=ONEPAY) and a parallel NAPAS set (bank.33 through bank.75, e.g. VCB-NAPAS bank.47 and Kebhana-NAPAS bank.75) that mostly set auth-site=BANK, use optional expiry formats, and allow empty cardholder names via a quiet-star card-name-format.",
      "evidence": [
        {
          "resource": "repo://src/main/resources/config.properties#L13-L18",
          "version": "repo-lines-v1:sha256:6911b34f9ec9113e260c952aea814c61fcb6ad17f687633a75f855e8906e5b90:"
