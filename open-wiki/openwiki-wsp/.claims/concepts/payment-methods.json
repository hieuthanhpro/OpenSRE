        }
      ]
    },
    {
      "id": "claim_02aac714136640a48db7fbdd43b20f16",
      "statement": "MigrationService.inputValidate applies per-bank card-format, card-name-format, card-name-and-no-format, card-month-format, card-year-format, card-type-format, and auth-method-format regexes from config.properties to reject VPC payment requests whose card number, expiry, card type, or auth method do not match the configured bank profile.",
      "evidence": [
