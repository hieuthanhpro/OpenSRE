  "claims": [
    {
      "id": "claim_28a7b3d1bf2a4076a07861b4776300b1",
      "statement": "config.properties defines per-bank card profiles keyed by numeric bankId with properties such as card-format.bank.<id>, card-name-format.bank.<id>, card-month-format.bank.<id>, card-year-format.bank.<id>, card-site.bank.<id>, auth-site.bank.<id>, and optional card-month-default/card-year-default; auth-site values of ONEPAY route authentication to the OnePAY hosted page while BANK routes to the bank/NAPAS-hosted page.",
      "evidence": [
        {
          "resource": "repo://src/main/resources/config.properties#L13-L18",
          "version": "repo-lines-v1:sha256:6911b34f9ec9113e260c952aea814c61fcb6ad17f687633a75f855e8906e5b90:"
        },
        {
          "resource": "repo://src/main/resources/config.properties#L20-L26",
          "version": "repo-lines-v1:sha256:90dda223f27102efd164f9b31ef5a50c8fba4f83a4fb1b97b10d4dafca0063b9:"
