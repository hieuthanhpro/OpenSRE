    },
    {
      "id": "claim_70ff814d6898408fb4991d44f241d768",
      "statement": "A PATCH response of state approved or failed causes WSP to enrich the PSP payment object with payment_data and bank_response_data and token_update_required, then update the MSP payment; after success it either redirects via auto-submitted HTML to merchant_return_url or to the invoice URL, incorporating per-merchant fail_delay behavior.",
      "evidence": [
