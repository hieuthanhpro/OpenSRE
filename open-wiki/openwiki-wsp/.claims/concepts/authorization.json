    {
      "id": "claim_d1aad283b8bb46618640d20d932885a7",
      "statement": "isInvoiceExpiredTime compares the invoice expire_time against now plus one minute; on a missing/malformed expire_time it safely returns false so the flow continues, while a genuine expiry fails the transaction with INVOICE_EXPIRED.",
