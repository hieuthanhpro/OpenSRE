    {
      "id": "claim_87836d41422b4e18a0a39be92c716054",
      "statement": "In update, after the MspAuthorizationDetails and optional updateAuthPending guards pass, the callback parameters (id, type payment, channel WSP, authorization_result) are PATCHed to the PSP/TSP /authorizations/:authId endpoint; the target (TSP, Onecredit, Kredivo, or Onecomm) and its signed HTTP client configuration are chosen from brand_id and Token/Onecredit mode.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/authorization/AuthorizationService.java#L187-L244",
