  "claims": [
    {
      "id": "claim_e6e904aa4a1a41e3a63b9d8110655976",
      "statement": "PaymentServiceApple routes an Apple Pay payment based on apple_data.s_card_type: MasterCard, Visa, and JCB are routed to the ONECREDIT PSP, while Napas cards are routed to the ONECOMM PSP; an unrecognized card type leaves pspId empty and aborts the request with VALIDATION_ERROR.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/applepay/PaymentServiceApple.java#L178-L251",
          "version": "repo-lines-v1:sha256:3ab326c6f86c0d75a8cc313c1d8824a089dc8dd41b354c75267be0a8e2dd6a81:"
        }
      ]
    },
    {
      "id": "claim_88c1da437979465898363e22dfd0de90",
      "statement": "PaymentServiceApple.create forwards the full encrypted Apple Pay body to the PSP-ONECREDIT token decryption endpoint /applepay-tokens with a 15000 ms timeout via PspOnecreditRequest.pspOnecreditPost before any payment is created.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/applepay/PaymentServiceApple.java#L54-L84",
          "version": "repo-lines-v1:sha256:35a386810e7de9f26be3f9d048717fec70e61a89d0e6d48dacdebe174884a05e:"
        }
      ]
    },
    {
      "id": "claim_c2f9ccaa8f464992aa035211a9921993",
      "statement": "Token decryption success is exactly a PSP response status of 200, 201, or 202; any other status fails the routing context with DECRYPT_TOKEN_ERROR ('Digital wallet token decrypt fail').",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/applepay/PaymentServiceApple.java#L131-L147",
          "version": "repo-lines-v1:sha256:5347dffc2f2b087b0d7bd40db2f2f7237ad3fa4d10b07936ca9d9f1c330eb75d:"
        }
      ]
    },
    {
      "id": "claim_635574cdb18f451dba636c3d310dabeb",
      "statement": "The international ONECREDIT path issues mspPut to /merchants/{merchant_id}/invoices/{invoice_id}/applepay-payments/{paymentId}, treating 200 or 201 as success and mapping other statuses to an ErrorExceptionExt; TimeoutException produces TRANSACTION_TIMEOUT (400).",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/applepay/PaymentServiceApple.java#L259-L300",
          "version": "repo-lines-v1:sha256:883b549e49e7572c69a2d7d1ba47ea2ad9634ada10f56b0f4b5a55fc03751e4c:"
        }
      ]
    },
    {
      "id": "claim_6b42d0af965b4c889f44bbc6557d7831",
      "statement": "The Napas ONECOMM path rewrites the instrument type to applepay_napas, attaches payment_data_decrypt and payment_method from the decryption response, and mspPuts to /merchants/{merchant_id}/invoices/{invoice_id}/applepay-napas/payments/{paymentId}; success is any status less than or equal to 201.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/applepay/PaymentServiceApple.java#L314-L329",
          "version": "repo-lines-v1:sha256:08e610ac2df096839913de4485167eb01a105be0ef41ee82f8dc172971618a23:"
        }
      ]
    },
    {
      "id": "claim_57d8daf889cd4bfc8001468a2d03149f",
      "statement": "In handleApplePayToken the instrument's HASH holds the PAN encrypted via OneSMHttpClient.encryptToBase64String using the onesm.url, onesm.client_id and onesm.client_key config with the onecredit.hmac handler, so the raw PAN is not stored in that field.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/applepay/PaymentServiceApple.java#L193-L197",
          "version": "repo-lines-v1:sha256:d9a15984dd23fa2316f9d2d19c042569d3e57e1fc7c59e099ab044c775b15788:"
        }
      ]
    },
    {
      "id": "claim_3e47035308704b58b82d8c3955a758ca",
      "statement": "The payment request includes a digitalWalletData object (dw_data) built from the decrypted ECI indicator, online payment cryptogram, payment data type, card type, s_type, and issuer information, plus apple_card_bin and the full apple_data under instrumentToSData.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/applepay/PaymentServiceApple.java#L199-L232",
          "version": "repo-lines-v1:sha256:a9cb5d0abec1a62762525c72a3bb9206af7c1553ba33a27ef9102c9ae973e374:"
        }
      ]
    },
    {
      "id": "claim_42d2903e55de4370be246869a806bfdf",
      "statement": "Token-response processing runs inside rc.vertx().executeBlocking so parsing and PAN encryption after decryption do not block the Vert.x event loop; failures are re-failed on the routing context.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/applepay/PaymentServiceApple.java#L99-L114",
          "version": "repo-lines-v1:sha256:d43510716f47b0aa692338f3fcc55c07f53044f543b27d2e60f35f287f1b30a1:"
        }
      ]
    },
    {
      "id": "claim_803f1588bf4c428ea86054588af0b5cc",
      "statement": "ApplePaySession.create forwards the request body to PSP-ONECREDIT at /merchants/{merchant_id}/invoices/{invoice_id}/applepay-sessions with a 30000 ms timeout; statuses 200, 201 and 202 are relayed through, while any other result is returned to the client as HTTP 200 with body {code:'1', msg:'Can't create Session', content:<raw>}.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/applepay/ApplePaySession.java#L14-L56",
          "version": "repo-lines-v1:sha256:69f835015d54031f65fa79f018e312fd3a3ee9caa74784856cea9d60fb31c9b8:"
        }
      ]
    },
    {
      "id": "claim_647d228f553048848bf127761503692b",
      "statement": "PspOnecreditRequest is the shared transport for Apple Pay calls to PSP-ONECREDIT: it targets Config.getPspOnecreditUrl() plus path, signs with region/service/access key credentials, supports POST/GET/PUT/PATCH wrappers, and delivers the response body to a caller-provided HttpResponseHandler while routing transport and body exceptions to the exception handler.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/applepay/PspOnecreditRequest.java#L22-L83",
          "version": "repo-lines-v1:sha256:724a923c79b5b3356250735397de558964f20ee809614aaefdb8ded2e745758d:"
        }
      ]
    },
    {
      "id": "claim_0ac078457f43494c99eb4d152f363dff",
      "statement": "The outgoing PSP-ONECREDIT request is built by Util.createHttpClientRequest, which selects the Vert.x HTTP or HTTPS client based on the URL scheme and signs the request with WSP's Authorization (X-OP-Authorization, X-OP-Date, X-OP-Expires, 900-second expiry) while forwarding X-Forwarded-For from the routing context.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/Util.java#L740-L791",
          "version": "repo-lines-v1:sha256:a65218150a710f64c05597fb396608dfe12c47a939ceb21e740f01540db3d695:"
        }
      ]
    },
    {
      "id": "claim_179d76be3236472186b2853475b47000",
      "statement": "The Apple Pay routes are registered in Server.applePay(Router) under Config.getUriPrefix(): POST applepay-sessions handled by ApplePaySession::create and POST applepay-payments (JSON) handled by PaymentServiceApple::create.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/Server.java#L434-L438",
          "version": "repo-lines-v1:sha256:fbe1f139810d09b784f3df7a3ad0aa414bba8d79cfdec9ef57c90398ce978219:"
        }
      ]
    },
    {
      "id": "claim_e73df7f871bb41d0b0aae879880fa1f2",
      "statement": "OneSMHttpClient.encryptToBase64String is invoked with the OneSM URL, client id, hex-decoded client key, and the 'onecredit.hmac' handler to produce the encrypted card hash used in the Apple Pay instrument.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/applepay/PaymentServiceApple.java#L193-L197",
          "version": "repo-lines-v1:sha256:d9a15984dd23fa2316f9d2d19c042569d3e57e1fc7c59e099ab044c775b15788:"
        }
      ]
    },
    {
      "id": "claim_63d0a5cccc5441edb6851d119dc40289",
      "statement": "The separate vn.onepay.wsp.resources.migration.mpgs3ds2.OnecreditClient is a distinct HTTP client for the MPGS 3DS2 migration flow (Mpgs3ds2/Mpgs3ds2AuthenticatePayer), not part of Apple Pay: it posts JSON to Config.getMigrationOnecreditBaseUrl() + '/onecredit/execute', restricts command_id values (CMPI_LOOKUP, AUTHENTICATE_PAYER, CANCEL, FINGERPRINT_QUERY), signs with an HMAC-SHA256 X-Secure-Hash header, and verifies the returned hash on 200 responses, defaulting its read timeout to Config.getPspOnecreditTimeout().",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/migration/mpgs3ds2/OnecreditClient.java#L46-L111",
          "version": "repo-lines-v1:sha256:d2fb4c27b9807581e20cf9fe8cec4997fbd458423b7aa6bd64a0ba14454f7eb4:"
        }
      ]
    },
    {
      "id": "claim_224a537222b74b978c32010c2a9aef3f",
      "statement": "There is no dedicated automated test covering PaymentServiceApple, ApplePaySession, or the applepay PspOnecreditRequest; the analogous Samsung Pay test (SamSungPayTransactionTest) is the closest coverage, verifying pspOneCreditPost invocation and subsequent Util.mspPut.",
      "evidence": [
        {
          "resource": "repo://src/test/java/vn/onepay/wsp/resources/samsung/SamSungPayTransactionTest.java#L24-L100",
          "version": "repo-lines-v1:sha256:6071bbfc410c26b416d8eddf04a644c6db7c2027004ad77e40760934e5e6c704:"
        }
      ]
    }
