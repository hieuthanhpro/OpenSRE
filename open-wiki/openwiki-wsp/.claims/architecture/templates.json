  "claims": [
    {
      "id": "claim_93cd356ca9e44092b8259b942546bc16",
      "statement": "The onecommweb migration package intercepts legacy ONECOMM API requests through handlers Vpc (vpc.op), Vpcpost (vpcpost.op), Vpcdps (Vpcdps.op), Traveloka (traveloka.op), and Refund (refund.op), which are routed in Server.migration().",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/Server.java#L468-L489",
          "version": "repo-lines-v1:sha256:a4258b6694ba0ed4952393458ec14fe87918b4393f5cb99148c102de78932908:"
        },
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/migration/onecommweb/Vpc.java#L21-L28",
          "version": "repo-lines-v1:sha256:e6162ad2e4054a402953189993dd2fbf54d2fc5f3a230ea1fc2f7a13d2e10f46:"
        }
      ]
    },
    {
      "id": "claim_24006174b4904991a8ae8b8f5b64e778",
      "statement": "Legacy VPC and Traveloka payment requests are translated to JSON via OnecommWebUtils.buildMigrationRequest() with gateway=ONECOMM and forwarded to the MSP /migration/paygate endpoint; a 302 response from MSP is passed through to the client as a redirect.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/migration/onecommweb/OnecommWebUtils.java#L198-L206",
          "version": "repo-lines-v1:sha256:6bc0af89d216e584d080d0182536ed719349ccc397f512a8f2f1340c3229a1df:"
        },
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/migration/onecommweb/Vpc.java#L60-L95",
          "version": "repo-lines-v1:sha256:c248e390c452a2f8a1992dbcaebad7d9a554ac4f5dae952a09ae3fa08f62fd75:"
        }
      ]
    },
    {
      "id": "claim_bcb7899201f54080af4a76ad5926b45a",
      "statement": "Refund.op posts a URL-encoded query string with GateWay=ONECOMM_REFUND to the MSP endpoint /vpc/merchant/{merchantId}/refunds/{merchTxnRef}, and returns the MSP body directly on HTTP 200 or 201 else builds a VPC-style error response.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/migration/onecommweb/Refund.java#L133-L157",
          "version": "repo-lines-v1:sha256:f574f75a066339201fa7bb22f0fa119bc3cc5f4dce74e6f3204ddece4cf9ebc0:"
        },
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/migration/onecommweb/Refund.java#L62-L120",
          "version": "repo-lines-v1:sha256:2cb7de6174ec7d1b03b2040bcdb228bfe5233cc96becd7cd587f77491e96a347:"
        }
      ]
    },
    {
      "id": "claim_eae3f614c9bd439280e9862686c819e1",
      "statement": "Vpcdps.op (query dispute resolution) is a placeholder that proxies to the existing ONECOMM ClientRequest.queryDR service instead of the new MSP migration endpoint, returning a URL-encoded text response.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/wsp/resources/migration/onecommweb/Vpcdps.java#L23-L60",
