    {
      "id": "claim_ad16f0e0e60c4c2f81f2a396d1bb7e88",
      "statement": "When the MSP call fails or returns a non-302 status, the handlers render a localized stop/error page via OnecommWebUtils.renderStopPage(), which detects locale from the vpc_Locale parameter or Accept-Language header and renders onecomm-web/stop.html with messages from Payment.properties or Payment_vi.properties.",
