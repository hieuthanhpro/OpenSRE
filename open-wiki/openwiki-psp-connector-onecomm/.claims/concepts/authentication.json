  "claims": [
    {
      "id": "claim_37dcb05d04f4409eb004bfcebec1c0bc",
      "statement": "ClientAuthorizationHandler is registered as a global handler for every route in PSPConnectorVertical, so every incoming API request is authenticated before reaching business handlers.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/vertical/PSPConnectorVertical.java#L102-L102",
          "version": "repo-lines-v1:sha256:84ab076b90cfd27d98a0ffc6afce4c6329299b2955b7f81ecbc31c26d97f2edc:"
        }
      ]
    },
    {
      "id": "claim_0f021792313d4bf7a3555c188d246a9d",
      "statement": "The handler rejects requests when the Accept or Content-Type header is not application/json, raising BadRequestException(INVALID_ACCEPT_HEADER) or BadRequestException(UNSUPPORTED_CONTENT_TYPE) respectively.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/handler/common/ClientAuthorizationHandler.java#L41-L51",
          "version": "repo-lines-v1:sha256:4b396184d7a5c0218994461ae28d39b7bfb69dacfcde0fcc44cba1eb67c02fd5:"
        }
      ]
    },
    {
      "id": "claim_a496ea286f0540a6aaa2a7ceac952cd4",
      "statement": "The handler requires the X-OP-Date, X-OP-Expires (positive integer), and X-OP-Authorization headers to be present, otherwise it throws BadRequestException with INVALID_X_OP_DATE, INVALID_X_OP_EXPIRES, or INVALID_X_OP_AUTHORIZATION respectively.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/handler/common/ClientAuthorizationHandler.java#L53-L69",
          "version": "repo-lines-v1:sha256:e7ab89491b3aeff49a71f64538e9fafbe98804384137b027e1cddaa477d5eecd:"
        }
      ]
    },
    {
      "id": "claim_dd350bf1a35a42b48a7afbbad46ddfcb",
      "statement": "The Client ID is extracted from the X-OP-Authorization header using the regex pattern SIGNATURE_HEADER_CHANNEL_ID_EXTRACT_REGEX (Credential=([^/|?]+)/), and an empty or missing Client ID causes AuthorizationException(INVALID_ACCESS_KEY).",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/common/util/AppConstants.java#L12-L12",
          "version": "repo-lines-v1:sha256:e229d52e8cc6f5e2dcebd88094f19b4f64f0302fc7f804500d20f7fd2b29f875:"
        },
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/handler/common/ClientAuthorizationHandler.java#L71-L77",
          "version": "repo-lines-v1:sha256:14a12450f9c6a426ad79b328b30af280484f0c75ad0c96e8ed7e22505a2ab692:"
        }
      ]
    },
    {
      "id": "claim_83ef5c945bfa413a9bc62ad5d2157185",
      "statement": "The parsed OWS1 request is validated for expiration (OPERATION_EXPIRED), region (INVALID_SERVICE_REGION), service name (INVALID_SERVICE_NAME), authorization terminator type (INVALID_AUTHORIZATION_SERVICE_NAME), and algorithm (INVALID_AUTHORIZATION_ALGORITHM), each raising AuthorizationException against the server-configured expected values.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/handler/common/ClientAuthorizationHandler.java#L79-L109",
          "version": "repo-lines-v1:sha256:1286aa1b022f96cb1bee4024741f54fe5108d3da37c08253eeb8b5b01a082dda:"
        }
      ]
    },
    {
      "id": "claim_b67cebbfb55a464bbd7e0df6520fc637",
      "statement": "The server-side expected service name, region, authorization type, and algorithm are configured in app.properties (service.name, service.region, service.authorization.type, service.authorization.algorithm) and injected into ClientAuthorizationHandler static fields in Main.main.",
