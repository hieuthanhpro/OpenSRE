    {
      "id": "claim_ead1cf22b8304ca1be716ea7ce432ec2",
      "statement": "Signature verification reconstructs a server-side vn.onepay.ows.Authorization using the Client ID, Access Key, request region and service, HTTP method, request path, query parameters, signed headers (subset of request headers named in the client's signed-headers list), request body bytes, request timestamp, and expiry; the recomputed signature must equal the client's signature or AuthorizationException(INVALID_SERVICE_SIGNATURE) is thrown.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/handler/common/ClientAuthorizationHandler.java#L111-L144",
          "version": "repo-lines-v1:sha256:8bba28732e88afb8543d5a61e56e88745b37eed0e95ee6ca773befd56ba366ed:"
        }
      ]
    },
