  "claims": [
    {
      "id": "claim_c963dc30d84a40379bc39512a0ee5212",
      "statement": "The refund workflow supports multiple entry points for different refund types: standard (POST /merchant/:id/refunds/:ref), NAPAS (POST /refund_napas), manual (POST /merchant/:id/refunds_manual/:ref), auto (POST /merchant/:id/refunds_auto/:ref), and Apple Pay (POST /refunds2).",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/vertical/PSPConnectorVertical.java#L128-L141",
          "version": "repo-lines-v1:sha256:01314dc99e6f7d703d62bd8535d742f6c36dcd0269a24a3037289d3892f5c0e7:"
        }
      ]
    },
    {
      "id": "claim_8b799a907f8543479eafcb2c0b36d65e",
      "statement": "RefundRule.isManual() determines whether a refund should be processed automatically or manually based on bank-specific rules, including time limits (e.g., 180 days for BIDV, 300 days for NAPAS banks, 90 days for VNPT Money/VietinBank), single-refund limits (e.g., BacABank), and data eligibility (e.g., MBBank requires mbbank_txn_info in jData).",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/common/rulerefund/RefundRule.java#L25-L129",
          "version": "repo-lines-v1:sha256:227079856e80ae40345e26b4fbcfda93ee90f57b20550a738eed5312666fc7e6:"
        }
      ]
    },
    {
      "id": "claim_890463a2edaa465f916b5178d82b80c8",
      "statement": "OnecommRefundServiceProvider.paymentRefund() orchestrates the standard refund flow: it validates the original payment is approved and a purchase type, calls RefundRule.isManual() to determine the processing path, inserts a PENDING refund record via RefundDB, and either calls OnecommGateway.refundExtend() for auto refunds or delegates to paymentRefundManual() for manual refunds.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/provider/onecomm/OnecommRefundServiceProvider.java#L42-L156",
          "version": "repo-lines-v1:sha256:93ad2666af6cb4f82697b9a0259c25ebdfd05c4d0c6ba83afcd8e1d706d60c10:"
        }
      ]
    },
    {
      "id": "claim_30e212b82ac1478e9e853f84002176c3",
      "statement": "OnecommRefundServiceProvider.paymentNPRefund() handles NAPAS-specific refunds by validating the bank ID against the napas.bank configuration property, then calling OnecommGateway.refundNP() with a RefundNPRequest object.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/provider/onecomm/OnecommRefundServiceProvider.java#L158-L236",
          "version": "repo-lines-v1:sha256:49d4a1a603543b0ac5db954142e8c7b6bffb2b2433b33830bc2df2be0c6c9271:"
        }
      ]
    },
    {
      "id": "claim_456bf247ddc7480a8319a1b208ad9929",
      "statement": "OnecommRefundServiceProvider.paymentRefundManual() processes manual refunds by immediately recording a RefundManual transaction status 400 (Approved) in OnecommDB and inserting an APPROVED refund record in RefundDB, bypassing any gateway communication.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/provider/onecomm/OnecommRefundServiceProvider.java#L356-L439",
          "version": "repo-lines-v1:sha256:28c8ec6db834acb82adc6eb93a97ece5ad27ad838328d6e078177d13ebeb6637:"
        }
      ]
    },
    {
      "id": "claim_438bf2750e1b48398fe129e72e8235a5",
      "statement": "OnecommRefundServiceProvider.updateRefund() allows updating a refund's state from Pending to Approved or Failed, with business rules that prevent updating terminal states, updating a non-existent refund to Approved, or updating an Onecomm-approved refund to Failed.",
      "evidence": [
