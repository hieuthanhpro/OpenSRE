  "claims": [
    {
      "id": "claim_94e1982f141c4992b8280c7cdc5c5f71",
      "statement": "PSPConnectorServer bootstraps the Vert.x runtime in a dedicated thread, building a Vertx instance with configurable worker pool size, event loop pool size, thread check interval, and worker/event-loop execution-time limits, then deploys a single PSPConnectorVertical verticle.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/PSPConnectorServer.java#L53-L71",
          "version": "repo-lines-v1:sha256:dccf12365184ce2013d8feb45f801358069632946fab7d2ece8e958f5237a34a:"
        }
      ]
    },
    {
      "id": "claim_70c6daa4ecab444eb95ad2bb9e31febf",
      "statement": "PSPConnectorVertical.start() builds the entire HTTP surface in one verticle: it creates the router, wires the global middleware chain (BodyHandler, ResponseTimeHandler, TimeoutHandler, RequestLoggingHandler, ClientAuthorizationHandler), registers route handlers, and creates the Vert.x HTTP server on the configured host/port.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/vertical/PSPConnectorVertical.java#L86-L159",
          "version": "repo-lines-v1:sha256:af83dd1ddabbac1379d55cbe22816b2ec77014cf72330f6c9bc1404cebdbe18d:"
        }
      ]
    },
    {
      "id": "claim_7b12ab6db613426b94a1655eeb6b7ea7",
      "statement": "Every request passes through a fixed middleware chain before any domain route handler runs: BodyHandler parses the body, ResponseTimeHandler adds the response-time header, TimeoutHandler aborts requests exceeding the configured connection timeout, RequestLoggingHandler logs the method/URI/body (with instrument data filtered), and ClientAuthorizationHandler validates headers, request expiry, and the HMAC signature using the client access key.",
      "evidence": [
        {
          "resource": "repo://src/main/java/vn/onepay/pspconnector/server/handler/common/ClientAuthorizationHandler.java#L33-L147",
          "version": "repo-lines-v1:sha256:949db3215a2fd35842a98f49a9b0c8a6e2a051d8ea2784aa16bcf944c31e52bd:"
        },
